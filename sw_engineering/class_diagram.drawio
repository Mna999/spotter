  <diagram name="0 Overview" id="sg0">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=left;" value="Smart Gym: Clean Architecture + BLoC (Reso Coder structure)" vertex="1">
          <mxGeometry height="34" width="1200" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="d" parent="1" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" value="Every feature page reads left to right: &lt;b&gt;Event / State, Bloc&lt;/b&gt; (presentation) &amp;rarr; &lt;b&gt;Use Cases, Repository&lt;/b&gt; (domain) &amp;rarr; &lt;b&gt;RepositoryImpl, Data Sources, Model&lt;/b&gt; (data) &amp;rarr; &lt;b&gt;Entity&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Every use case is &lt;i&gt;UseCase&amp;lt;Type, Params&amp;gt;&lt;/i&gt; returning &lt;i&gt;Future&amp;lt;Either&amp;lt;Failure, Type&amp;gt;&amp;gt;&lt;/i&gt;. Models extend Entities and name the Firestore collection they map to. Page C = core classes, page D = injection container (get_it)." vertex="1">
          <mxGeometry height="130" width="1220" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="l0" parent="1" style="shape=rect;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="«bloc»" vertex="1">
