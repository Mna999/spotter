        <mxCell id="DIr" parent="1" style="shape=rect;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fillColor=#ffd9b3;strokeColor=#c55a11;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«DI»&lt;/i&gt;&lt;br&gt;&lt;b&gt;registerLazySingleton: Repositories&lt;/b&gt;&lt;br&gt;&lt;i&gt;data  (registered under the domain interface)&lt;/i&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;1 Auth and Profile&lt;/b&gt;&lt;br&gt;&amp;lt;IAuthRepository&amp;gt; → AuthRepositoryImpl(AuthRemoteDataSource, NetworkInfo)&lt;br&gt;&amp;lt;IProfileRepository&amp;gt; → ProfileRepositoryImpl(ProfileRemoteDataSource, NetworkInfo)&lt;br&gt;&lt;b&gt;2 Pose Coaching&lt;/b&gt;&lt;br&gt;&amp;lt;IExerciseRuleRepository&amp;gt; → ExerciseRuleRepositoryImpl(ExerciseRemoteDataSource, ExerciseLocalDataSource, NetworkInfo)&lt;br&gt;&lt;b&gt;3 Workout Session and Safety&lt;/b&gt;&lt;br&gt;&amp;lt;IWorkoutRepository&amp;gt; → WorkoutRepositoryImpl(WorkoutRemoteDataSource, WorkoutLocalDataSource, NetworkInfo)&lt;br&gt;&amp;lt;ISetRepository&amp;gt; → SetRepositoryImpl(SetRemoteDataSource, SetLocalDataSource, NetworkInfo)&lt;br&gt;&amp;lt;ISafetyAcknowledgementRepository&amp;gt; → SafetyAcknowledgementRepositoryImpl(SafetyAckRemoteDataSource, NetworkInfo)&lt;br&gt;&amp;lt;IAlertRepository&amp;gt; → AlertRepositoryImpl(AlertRemoteDataSource, NetworkInfo)&lt;br&gt;&lt;b&gt;4 Wristband and Biometrics&lt;/b&gt;&lt;br&gt;&amp;lt;IWristbandGateway&amp;gt; → WristbandGatewayImpl(BleWristbandDataSource)&lt;br&gt;&amp;lt;IBiometricRepository&amp;gt; → BiometricRepositoryImpl(BiometricRemoteDataSource, BiometricLocalDataSource, NetworkInfo)&lt;br&gt;&amp;lt;IDeviceRepository&amp;gt; → DeviceRepositoryImpl(DeviceRemoteDataSource, NetworkInfo)&lt;br&gt;&lt;b&gt;5 Nutrition and Meal Planning&lt;/b&gt;&lt;br&gt;&amp;lt;IFoodRepository&amp;gt; → FoodRepositoryImpl(FoodRemoteDataSource, FoodLocalDataSource, NetworkInfo)&lt;br&gt;&amp;lt;INutritionPreferencesRepository&amp;gt; → NutritionPreferencesRepositoryImpl(NutritionPrefsRemoteDataSource, NetworkInfo)&lt;br&gt;&amp;lt;IMealPlanRepository&amp;gt; → MealPlanRepositoryImpl(MealRemoteDataSource, NetworkInfo)&lt;br&gt;&amp;lt;IMealRepository&amp;gt; → MealRepositoryImpl(MealRemoteDataSource, NetworkInfo)&lt;br&gt;&lt;b&gt;6 Chat Assistant&lt;/b&gt;&lt;br&gt;&amp;lt;IChatRepository&amp;gt; → ChatRepositoryImpl(ChatRemoteDataSource, NetworkInfo)&lt;br&gt;&amp;lt;ILlmGateway&amp;gt; → LlmGatewayImpl(LlmRemoteDataSource, NetworkInfo)&lt;br&gt;&amp;lt;IUserContextRepository&amp;gt; → UserContextRepositoryImpl(UserContextLocalDataSource)&lt;br&gt;&amp;lt;IFallbackReplyRepository&amp;gt; → FallbackReplyRepositoryImpl(FallbackReplyLocalDataSource)&lt;br&gt;&lt;b&gt;7 Progress Analytics&lt;/b&gt;&lt;br&gt;&amp;lt;IActivityTargetRepository&amp;gt; → ActivityTargetRepositoryImpl(ActivityTargetRemoteDataSource, NetworkInfo)&lt;br&gt;&lt;b&gt;8 Settings and Compliance&lt;/b&gt;&lt;br&gt;&amp;lt;ISettingsRepository&amp;gt; → SettingsRepositoryImpl(SettingsRemoteDataSource, SettingsLocalDataSource, NetworkInfo)&lt;br&gt;&amp;lt;IConsentRepository&amp;gt; → ConsentRepositoryImpl(ConsentLocalDataSource)" vertex="1">
