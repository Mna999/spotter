          <mxGeometry height="92" width="370" x="2195" y="271" as="geometry" />
        </mxCell>
        <mxCell id="3pam_peNnQq-Qgu-k1tc-59" parent="1" style="shape=rect;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fillColor=#eeeeee;strokeColor=#333333;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«core»&lt;/i&gt;&lt;br&gt;&lt;b&gt;InvalidInputFailure&lt;/b&gt;&lt;br&gt;&lt;i&gt;extends Failure&lt;/i&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;text cannot be parsed (InputConverter)&lt;/font&gt;&lt;/i&gt;" vertex="1">
