        </mxCell>
        <mxCell id="3pam_peNnQq-Qgu-k1tc-63" parent="1" style="shape=rect;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fillColor=#eeeeee;strokeColor=#333333;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«core»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ServerException&lt;/b&gt;&lt;br&gt;&lt;i&gt;implements Exception&lt;/i&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;thrown by remote data sources&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;repository maps it to ServerFailure&lt;/font&gt;&lt;/i&gt;" vertex="1">
