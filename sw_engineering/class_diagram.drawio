        <mxCell id="3pam_peNnQq-Qgu-k1tc-52" parent="1" style="shape=rect;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«external: equatable»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Equatable&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ props: List&amp;lt;Object?&amp;gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;value equality for Failure, NoParams, events, states&lt;/font&gt;&lt;/i&gt;" vertex="1">
