  <diagram name="D Dependency Injection (injection_container.dart)" id="sg2">
    <mxGraphModel dx="1441" dy="730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3490" pageHeight="1339" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" value="D Dependency Injection: injection_container.dart (get_it service locator)" vertex="1">
          <mxGeometry x="40" y="10" width="2960" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;" value="Same shape as the Reso Coder tutorial: one global sl = GetIt.instance, one init(), grouped by feature; Blocs are factories, everything else is a lazy singleton" vertex="1">
          <mxGeometry x="40" y="42" width="2960" height="20" as="geometry" />
        </mxCell>
        <mxCell id="DI" parent="1" style="shape=rect;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fillColor=#ffd9b3;strokeColor=#c55a11;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«DI»&lt;/i&gt;&lt;br&gt;&lt;b&gt;injection_container.dart&lt;/b&gt;&lt;br&gt;&lt;i&gt;top-level file, as in the tutorial&lt;/i&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ sl: GetIt  = GetIt.instance&lt;hr size=&quot;1&quot;&gt;+ init(): Future&amp;lt;void&amp;gt;&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;1. Features: Bloc, Use cases, Repository, Data sources&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;2. Core&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;3. External&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;Bloc: registerFactory, everything else: registerLazySingleton&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry x="1435" y="100" width="620" height="187" as="geometry" />
        </mxCell>
        <mxCell id="DIb" parent="1" style="shape=rect;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fillColor=#ffd9b3;strokeColor=#c55a11;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«DI»&lt;/i&gt;&lt;br&gt;&lt;b&gt;registerFactory: Blocs&lt;/b&gt;&lt;br&gt;&lt;i&gt;presentation&lt;/i&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;1 Auth and Profile&lt;/b&gt;&lt;br&gt;AuthBloc(signUp, signIn, resetPassword, restoreSession, signOut, deleteAccount)&lt;br&gt;OnboardingBloc(completeOnboarding, computeBodyMetrics, inputConverter)&lt;br&gt;ProfileBloc(computeBodyMetrics, updateWeeklyTarget)&lt;br&gt;&lt;b&gt;2 Pose Coaching&lt;/b&gt;&lt;br&gt;CoachingBloc(startCalibration, processPoseFrame, generateFeedbackCue, buildSetSummary)&lt;br&gt;ModelSettingsBloc(selectPoseModel, monitorPerformance)&lt;br&gt;&lt;b&gt;3 Workout Session and Safety&lt;/b&gt;&lt;br&gt;WorkoutSessionBloc(createWorkout, startRestTimer, logSet, checkHeartRateCaution, raiseAlert, acknowledgeAlert)&lt;br&gt;SafetyBriefingBloc(acknowledgeSafety)&lt;br&gt;&lt;b&gt;4 Wristband and Biometrics&lt;/b&gt;&lt;br&gt;WristbandBloc(connectWristband, observeBiometrics, monitorBattery, syncUserBodyData, aggregateBiometricWindow)&lt;br&gt;&lt;b&gt;5 Nutrition and Meal Planning&lt;/b&gt;&lt;br&gt;FoodSearchBloc(searchFood)&lt;br&gt;MealPlanBloc(generateMealPlan, regenerateUnderBudget, manageDietaryExclusions, saveMealPlan)&lt;br&gt;FoodLogBloc(logFood, repeatYesterday, getDailyTotals)&lt;br&gt;&lt;b&gt;6 Chat Assistant&lt;/b&gt;&lt;br&gt;ChatBloc(sendChatMessage, loadChatHistory, clearChatHistory, buildChatContext, getFallbackReply)&lt;br&gt;&lt;b&gt;7 Progress Analytics&lt;/b&gt;&lt;br&gt;ProgressBloc(getFormScoreTrend, getHeartRateTrend)&lt;br&gt;AdherenceBloc(computeAdherence)&lt;br&gt;&lt;b&gt;8 Settings and Compliance&lt;/b&gt;&lt;br&gt;SettingsBloc(updateLocaleSettings)&lt;br&gt;PrivacyBloc(recordConsent, withdrawConsent, purgeExpiredBiometrics)" vertex="1">
          <mxGeometry x="40" y="377" width="560" height="467" as="geometry" />
        </mxCell>
        <mxCell id="DIu" parent="1" style="shape=rect;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fillColor=#ffd9b3;strokeColor=#c55a11;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«DI»&lt;/i&gt;&lt;br&gt;&lt;b&gt;registerLazySingleton: Use cases&lt;/b&gt;&lt;br&gt;&lt;i&gt;domain&lt;/i&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;1 Auth and Profile&lt;/b&gt;&lt;br&gt;SignUpUseCase(IAuthRepository, IProfileRepository)&lt;br&gt;SignInUseCase(IAuthRepository)&lt;br&gt;ResetPasswordUseCase(IAuthRepository)&lt;br&gt;RestoreSessionUseCase(IAuthRepository)&lt;br&gt;SignOutUseCase(IAuthRepository)&lt;br&gt;DeleteAccountUseCase(IAuthRepository)&lt;br&gt;CompleteOnboardingUseCase(IProfileRepository)&lt;br&gt;ComputeBodyMetricsUseCase(IProfileRepository)&lt;br&gt;UpdateWeeklyTargetUseCase(IActivityTargetRepository)&lt;br&gt;&lt;b&gt;2 Pose Coaching&lt;/b&gt;&lt;br&gt;StartCalibrationUseCase(ICueSpeaker)&lt;br&gt;ProcessPoseFrameUseCase(IPoseEstimator, IExerciseRuleRepository)&lt;br&gt;GenerateFeedbackCueUseCase(ICueSpeaker)&lt;br&gt;BuildSetSummaryUseCase(ISetRepository)&lt;br&gt;SelectPoseModelUseCase(IDeviceCapabilityProvider)&lt;br&gt;MonitorPerformanceUseCase(IDeviceCapabilityProvider)&lt;br&gt;&lt;b&gt;3 Workout Session and Safety&lt;/b&gt;&lt;br&gt;CreateWorkoutUseCase(IWorkoutRepository)&lt;br&gt;StartRestTimerUseCase()&lt;br&gt;LogSetUseCase(IWorkoutRepository, ISetRepository)&lt;br&gt;CheckHeartRateCautionUseCase(IBiometricRepository)&lt;br&gt;RaiseAlertUseCase(IAlertRepository)&lt;br&gt;AcknowledgeAlertUseCase(IAlertRepository)&lt;br&gt;AcknowledgeSafetyUseCase(ISafetyAcknowledgementRepository)&lt;br&gt;&lt;b&gt;4 Wristband and Biometrics&lt;/b&gt;&lt;br&gt;ConnectWristbandUseCase(IWristbandGateway, IDeviceRepository)&lt;br&gt;ObserveBiometricsUseCase(IWristbandGateway)&lt;br&gt;MonitorBatteryUseCase(IWristbandGateway, IDeviceRepository)&lt;br&gt;SyncUserBodyDataUseCase(IWristbandGateway)&lt;br&gt;AggregateBiometricWindowUseCase(IBiometricRepository)&lt;br&gt;&lt;b&gt;5 Nutrition and Meal Planning&lt;/b&gt;&lt;br&gt;SearchFoodUseCase(IFoodRepository)&lt;br&gt;GenerateMealPlanUseCase(IFoodRepository, INutritionPreferencesRepository)&lt;br&gt;RegenerateUnderBudgetUseCase(IFoodRepository, INutritionPreferencesRepository)&lt;br&gt;ManageDietaryExclusionsUseCase(INutritionPreferencesRepository)&lt;br&gt;SaveMealPlanUseCase(IMealPlanRepository)&lt;br&gt;LogFoodUseCase(IMealRepository)&lt;br&gt;RepeatYesterdayUseCase(IMealRepository)&lt;br&gt;GetDailyTotalsUseCase(IMealRepository)&lt;br&gt;&lt;b&gt;6 Chat Assistant&lt;/b&gt;&lt;br&gt;SendChatMessageUseCase(ILlmGateway, IChatRepository)&lt;br&gt;LoadChatHistoryUseCase(IChatRepository)&lt;br&gt;ClearChatHistoryUseCase(IChatRepository)&lt;br&gt;BuildChatContextUseCase(IUserContextRepository)&lt;br&gt;GetFallbackReplyUseCase(IFallbackReplyRepository)&lt;br&gt;&lt;b&gt;7 Progress Analytics&lt;/b&gt;&lt;br&gt;GetFormScoreTrendUseCase(ISetRepository)&lt;br&gt;GetHeartRateTrendUseCase(IBiometricRepository)&lt;br&gt;ComputeAdherenceUseCase(IWorkoutRepository, IActivityTargetRepository)&lt;br&gt;&lt;b&gt;8 Settings and Compliance&lt;/b&gt;&lt;br&gt;UpdateLocaleSettingsUseCase(ISettingsRepository)&lt;br&gt;RecordConsentUseCase(IConsentRepository)&lt;br&gt;WithdrawConsentUseCase(IConsentRepository)&lt;br&gt;PurgeExpiredBiometricsUseCase(IBiometricRepository)" vertex="1">
