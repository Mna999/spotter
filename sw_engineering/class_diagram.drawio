        </mxCell>
        <mxCell id="3pam_peNnQq-Qgu-k1tc-55" parent="1" style="shape=rect;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«external: internet_connection_checker»&lt;/i&gt;&lt;br&gt;&lt;b&gt;InternetConnectionChecker&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ hasConnection: Future&amp;lt;bool&amp;gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;DataConnectionChecker in the tutorial (same API)&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="92" width="330" x="1275" y="488" as="geometry" />
        </mxCell>
        <mxCell id="3pam_peNnQq-Qgu-k1tc-56" parent="1" style="shape=rect;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fillColor=#eeeeee;strokeColor=#333333;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«core»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Failure&lt;/b&gt;&lt;br&gt;&lt;i&gt;abstract · extends Equatable&lt;/i&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;+ props: List&amp;lt;Object?&amp;gt;&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;base of every error crossing into the domain&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="117" width="350" x="1725" y="432" as="geometry" />
        </mxCell>
        <mxCell id="3pam_peNnQq-Qgu-k1tc-57" parent="1" style="shape=rect;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=4;fontSize=11;fillColor=#eeeeee;strokeColor=#333333;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«core»&lt;/i&gt;&lt;br&gt;&lt;b&gt;ServerFailure&lt;/b&gt;&lt;br&gt;&lt;i&gt;extends Failure&lt;/i&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;remote call failed (Firestore, REST, Firebase)&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="92" width="370" x="2195" y="155" as="geometry" />
        </mxCell>
