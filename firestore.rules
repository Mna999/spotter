rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // admin custom claim, set from the Admin SDK / a Cloud Function
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // users/{uid}: document ID is the Auth UID.
    // Ownership is enforced by the path itself, so nested docs
    // don't need a uid field.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid);

      match /workouts/{workoutId} {
        allow read, create, update, delete: if isOwner(uid);

        match /plannedExercises/{plannedExerciseId} {
          allow read, create, update, delete: if isOwner(uid);

          match /sets/{setId} {
            allow read, create, update, delete: if isOwner(uid);
          }
        }
      }
    }

    // Legacy user-owned top-level collections: each document carries the owner's uid field
    match /{collection}/{docId} {
      allow read, delete: if collection in
          ['workouts', 'sets', 'biometrics', 'meals', 'mealLogs', 'chat', 'alerts', 'devices']
          && isOwner(resource.data.uid);

      allow create: if collection in
          ['workouts', 'sets', 'biometrics', 'meals', 'mealLogs', 'chat', 'alerts', 'devices']
          && isOwner(request.resource.data.uid);

      allow update: if collection in
          ['workouts', 'sets', 'biometrics', 'meals', 'mealLogs', 'chat', 'alerts', 'devices']
          && isOwner(resource.data.uid)
          && request.resource.data.uid == resource.data.uid;
    }

    // Foods: any signed-in user reads.
    // Admins write anything; users can create/edit/delete only
    // custom foods that carry their own uid.
    match /foods/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
          || isOwner(request.resource.data.uid);
      allow update: if isAdmin()
          || (isOwner(resource.data.uid)
              && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin()
          || isOwner(resource.data.uid);
    }

    match /exercises/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /appConfig/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Audit log: admins can read, nobody writes from a client.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything not matched above is denied by default.
  }
}